# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.env.vercel
.env*.local
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# playwright
# NOTE: /e2e and /playwright.config.ts are intentionally NOT ignored — the spec
# (§11, §15) requires the E2E suite to be committed. Only generated output is ignored.
.playwright-mcp
/test-results
/playwright-report
/blob-report
/playwright/.cache

# swc
/.swc

# testing
/coverage

# claude code
.claude/settings.local.json

# drizzle-kit output is generated; migrations are committed from ./drizzle when they exist
.drizzle
