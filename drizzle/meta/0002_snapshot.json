        "games_bot_shape": {
          "name": "games_bot_shape",
          "value": "(\"type\" = 'bot' and \"bot_level\" is not null and \"player_b_id\" is null)\n          or (\"type\" <> 'bot' and \"bot_level\" is null)"
        },
        "games_bot_games_unrated": {
          "name": "games_bot_games_unrated",
          "value": "not \"rated\" or \"type\" <> 'bot'"
        },
        "games_rating_delta_requires_rated": {
          "name": "games_rating_delta_requires_rated",
          "value": "\"rated\" or (\"rating_delta_a\" is null and \"rating_delta_b\" is null)"
        },
        "games_winner_is_a_player": {
          "name": "games_winner_is_a_player",
          "value": "\"winner_id\" is null or \"winner_id\" = \"player_a_id\" or \"winner_id\" = \"player_b_id\""
        },
        "games_status_coherent": {
          "name": "games_status_coherent",
          "value": "(\"status\" = 'live' and \"ended_at\" is null and \"winner_id\" is null and \"result_reason\" is null)\n          or (\"status\" = 'completed' and \"ended_at\" is not null and \"result_reason\" is not null)\n          or (\"status\" = 'aborted' and \"ended_at\" is not null)"
        },
        "games_move_count_non_negative": {
          "name": "games_move_count_non_negative",
          "value": "\"move_count\" >= 0"
        }
      },
