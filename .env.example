# --- Database (Neon Postgres) -------------------------------------------------
# Pooled connection string from the Neon dashboard. Prefer an EU region (spec §11,
# GDPR data-residency preference).
DATABASE_URL="postgresql://user:password@ep-example-000000.eu-central-1.aws.neon.tech/seaduel?sslmode=require"

# --- Auth (better-auth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Site ---------------------------------------------------------------------
# Absolute origin used for canonical URLs, hreflang alternates, sitemap.xml and
# robots.txt. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# --- Realtime game layer (Cloudflare Worker) ----------------------------------
# Shared with src/worker. Signs connection tickets going out and verifies game-result
# reports coming back. Must match GAME_TICKET_SECRET in .env.worker.
# Generate with: openssl rand -base64 32
GAME_TICKET_SECRET="replace-me-with-a-32-byte-random-secret"

# Where the browser opens the game socket. Defaults to the local `wrangler dev` port,
# so a fresh checkout needs no value here.
NEXT_PUBLIC_GAME_WS_URL="ws://localhost:8787"

# Authorises the scheduled cleanup of abandoned games (/api/cron/abandoned-games).
# Optional: with no value the route refuses to run, which is what you want locally —
# nothing then rewrites rows during ordinary play or a test run. Set it in the
# deployment environment, where Vercel's scheduler sends it as a bearer token.
# CRON_SECRET="replace-me-with-a-random-secret"
