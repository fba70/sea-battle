# --- Database (Neon Postgres) -------------------------------------------------
# Pooled connection string from the Neon dashboard. Prefer an EU region (spec §11,
# GDPR data-residency preference).
DATABASE_URL="postgresql://user:password@ep-example-000000.eu-central-1.aws.neon.tech/seaduel?sslmode=require"

# --- Auth (better-auth) -------------------------------------------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET="replace-me-with-a-32-byte-random-secret"
BETTER_AUTH_URL="http://localhost:3000"

# Public base URL used by the browser auth client.
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Site ---------------------------------------------------------------------
# Absolute origin used for canonical URLs, hreflang alternates, sitemap.xml and
# robots.txt. Defaults to http://localhost:3000 when unset.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
