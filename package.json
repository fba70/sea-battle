{
  "name": "seaduel",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20.9.0",
    "npm": ">=11.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "tsc --noEmit && tsc --noEmit -p src/worker/tsconfig.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "generate:sfx": "node scripts/generate-sfx.mjs",
    "test": "vitest run && npm run test:workers",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:no-webkit": "PLAYWRIGHT_SKIP_WEBKIT=1 playwright test",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/migrate.mjs",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test:workers": "vitest run --config vitest.workers.config.ts",
    "worker:dev": "wrangler dev --env-file .env.worker",
    "worker:typecheck": "tsc --noEmit -p src/worker/tsconfig.json",
    "worker:deploy": "wrangler deploy --env-file .env.worker",
    "worker:build": "wrangler deploy --dry-run --outdir .wrangler/dry-run"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "^1.7.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.2.6",
    "drizzle-orm": "^0.45.2",
    "geist": "^1.7.2",
    "howler": "^2.2.4",
    "lucide-react": "^1.43.0",
    "motion": "^13.2.0",
    "next": "16.3.4",
    "next-intl": "^4.14.2",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zod": "^4.5.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.22.0",
    "@cloudflare/workers-types": "^5.20260923.1",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/howler": "^2.2.13",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.136.3"
  }
}
