{
  // The Worker runs on workerd, not in a browser and not in Node. Pulling the DOM lib
  // in here would merge DOM's globals with Cloudflare's — `WebSocket.binaryType` would
  // typecheck and then be undefined at runtime. This config gives the worker only the
  // types it actually has.
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["@cloudflare/workers-types"],
    "noEmit": true
  },
  // The root config excludes `src/worker` so Next never compiles it, and `exclude` is
  // inherited through `extends` and filters `include` — so without this override the
  // Worker's own source was silently dropped from its own typecheck.
  //
  // The `.worker.test.ts` files stay out: they import the virtual `cloudflare:test`
  // module, whose types live behind a package subpath that neither `types` nor a
  // reference file resolves in this version. They are exercised by `npm run
  // test:workers`, which is how they were covered before this override existed.
  "exclude": ["./**/*.worker.test.ts"],
  "include": [
    "./**/*.ts",
    "./**/*.d.ts",
    "../game/**/*.ts",
    "../server/**/*.ts",
    "../rating/**/*.ts"
  ]
}
